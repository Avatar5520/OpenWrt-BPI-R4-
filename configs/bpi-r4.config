# === 1. 目標機型 (自動包含所有 BPI-R4 原生 6.12 驅動、Wi-Fi 7 及 mt7988-wo-firmware) ===
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_bananapi_bpi-r4=y

# === 2. LuCI 網頁管理介面與繁體中文語言包 ===
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-i18n-base-zh-tw=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-tw=y

# === 3. 完整保留現有 R4 核心應用套件 ===
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y

CONFIG_PACKAGE_luci-app-banip=y
CONFIG_PACKAGE_luci-i18n-banip-zh-tw=y
CONFIG_PACKAGE_kmod-nft-netdev=y

CONFIG_PACKAGE_luci-app-adblock=y
CONFIG_PACKAGE_luci-i18n-adblock-zh-tw=y

CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-tw=y

CONFIG_PACKAGE_luci-app-attendedsysupgrade=y

# === 4. 光模組診斷與規則處理加速工具 ===
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_gzip=y
CONFIG_PACKAGE_coreutils-sort=y
CONFIG_PACKAGE_tcpdump-mini=y
